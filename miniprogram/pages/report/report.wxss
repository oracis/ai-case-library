.page { padding: 24rpx 24rpx 80rpx; display: flex; flex-direction: column; gap: 18rpx; }

/* ---- 未购买引导 ---- */
.gate { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 60rpx 40rpx; text-align: center; }
.g-ico { font-size: 64rpx; }
.g-h { font-size: 32rpx; font-weight: 700; }
.g-p { font-size: 25rpx; color: var(--text-2); line-height: 1.7; }
.g-price { font-family: ui-monospace, Menlo, monospace; font-size: 44rpx; font-weight: 700; color: var(--money); }
.g-unit { font-size: 24rpx; color: var(--text-3); }
.g-note { font-size: 21rpx; color: var(--text-3); }

/* ---- 报告正文 ---- */
.head { display: flex; flex-direction: column; gap: 10rpx; }
.rp-badge {
  font-size: 21rpx; color: var(--money); font-weight: 600;
  background: var(--money-dim); border-radius: 12rpx; padding: 2rpx 16rpx;
}
.rp-date { font-size: 21rpx; color: var(--text-3); }
.h-name { font-size: 34rpx; font-weight: 700; }
.h-one { font-size: 25rpx; color: var(--text-2); line-height: 1.65; }

.sec { display: flex; flex-direction: column; gap: 12rpx; }
.sec-h {
  font-size: 25rpx; font-weight: 650;
  padding-left: 14rpx; border-left: 4rpx solid var(--money);
}
.sec-p { font-size: 26rpx; color: var(--text-2); line-height: 1.75; }
.sec-warn { font-size: 21rpx; color: var(--v-partial); }

.pb-item { display: flex; gap: 14rpx; align-items: flex-start; }
.pb-num {
  flex: 0 0 auto; width: 36rpx; height: 36rpx; border-radius: 10rpx;
  background: var(--money-dim); color: var(--money);
  font-family: ui-monospace, Menlo, monospace; font-size: 22rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; margin-top: 4rpx;
}
.pb-t { flex: 1; font-size: 26rpx; color: var(--text-2); line-height: 1.7; }
.pb-note { font-size: 22rpx; color: var(--text-3); }

.tf-item { display: flex; gap: 12rpx; align-items: flex-start; }
.tf-dot {
  flex: 0 0 auto; width: 10rpx; height: 10rpx; border-radius: 50%;
  background: var(--accent); margin-top: 14rpx;
}
.tf-t { flex: 1; font-size: 26rpx; color: var(--text-2); line-height: 1.7; }

.ev-row { display: flex; align-items: baseline; gap: 12rpx; }
.ev-v { font-family: ui-monospace, Menlo, monospace; font-size: 30rpx; font-weight: 700; color: var(--money); }
.ev-c { font-size: 20rpx; color: var(--text-3); }
.ev-none { font-size: 24rpx; color: var(--text-3); }
.ev-tags { flex-wrap: wrap; gap: 10rpx; }
.ev-note {
  font-size: 21rpx; color: var(--v-partial); line-height: 1.65;
  background: rgba(229,181,103,.07); border-radius: 12rpx; padding: 12rpx 16rpx;
}

.foot { text-align: center; font-size: 20rpx; padding: 24rpx 0; line-height: 1.7; }
