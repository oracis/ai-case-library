.page { padding: 24rpx 24rpx 80rpx; display: flex; flex-direction: column; gap: 18rpx; }

.head { display: flex; flex-direction: column; gap: 12rpx; }
.h-name { font-size: 36rpx; font-weight: 700; letter-spacing: .2rpx; }
.h-country { font-size: 22rpx; color: var(--text-3); }
.h-one { font-size: 26rpx; color: var(--text-2); line-height: 1.65; }
.h-tags { flex-wrap: wrap; gap: 10rpx; }

/* 收入区：左对齐竖排，每个数字下面挂口径 */
.rev { display: flex; gap: 40rpx; flex-wrap: wrap; margin-top: 8rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); }
.rev-item { display: flex; flex-direction: column; gap: 2rpx; }
.rev-v { font-family: ui-monospace, Menlo, monospace; font-size: 38rpx; font-weight: 700; color: var(--money); letter-spacing: -.5rpx; }
.rev-c { font-size: 20rpx; color: var(--text-3); }
.rev-none { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; padding-top: 16rpx; border-top: 1rpx solid var(--border); }

.scores { padding: 20rpx 28rpx; }
.sc-row { justify-content: space-between; }
.sc-cell { display: flex; flex-direction: column; align-items: center; gap: 4rpx; flex: 1; }
.sc-v { font-family: ui-monospace, Menlo, monospace; font-size: 40rpx; font-weight: 700; color: var(--text); }
.sc-v.accent { color: var(--accent); }
.sc-l { font-size: 21rpx; color: var(--text-3); }

.sec { display: flex; flex-direction: column; gap: 10rpx; }
.sec-h {
  font-size: 24rpx; font-weight: 650; color: var(--text);
  padding-left: 14rpx; border-left: 4rpx solid var(--accent);
}
.sec-p { font-size: 26rpx; color: var(--text-2); line-height: 1.75; }
.sec-p.verdict { color: var(--text); font-weight: 550; }

/* 深度报告卡：绿色描边强调「这是付费功能区」，和免费内容视觉隔离 */
.report {
  border: 1rpx solid rgba(70, 211, 138, .3);
  background: linear-gradient(180deg, rgba(70,211,138,.05), transparent 40%), var(--surface);
  display: flex; flex-direction: column; gap: 16rpx;
}
.rp-h { font-size: 30rpx; font-weight: 700; }
.rp-sub { font-size: 21rpx; color: var(--text-3); margin-top: 2rpx; }
.rp-price { font-family: ui-monospace, Menlo, monospace; font-size: 32rpx; font-weight: 700; color: var(--money); }

.rp-points { display: flex; flex-direction: column; gap: 8rpx; }
.rp-p { font-size: 24rpx; color: var(--text-2); line-height: 1.6; }
.rp-note { font-size: 20rpx; color: var(--text-3); text-align: center; }
.rp-open { padding: 6rpx 0; }

.foot { text-align: center; font-size: 20rpx; padding: 24rpx 0; line-height: 1.7; }
