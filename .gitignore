# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 自测产生的备份与临时文件
.selftest_backup/
data/.selftest_backup_cases
data/__test_*.json
data/verification_log.json

# 管理员凭据（后台登录密码摘要 + token 签名密钥）：绝不入库
# 用通配而不是精确名：auth.py --reset / --set 之前人可能会先备份一份，
# 那个 .bak 里带着**同一个签名密钥**，漏掉它等于凭据照样进了库。
data/admin.json
data/admin.json.*
data/verifications.json
# LLM API Key（后台「AI 核实」面板保存的那份）：绝不入库
data/secrets.json

# 本地服务日志
*.log

# IndieHackers sitemap slug 缓存（scripts/harvest.py 生成）
# 属派生数据：默认通道走列表页，不需要它；提交进来只会变成会长期增长的噪音。
data/ih_slugs.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 初筛结果快照（scripts/triage.py --write 生成）
# 属派生数据：随时可由 scripts/triage.py 重算，且**每天都不一样** ——
# 提交进来只会变成一份很快过期的噪音。
data/triage.json

# 静态构建产物（scripts/build_static.py 生成，不入库）
dist/
# 对外发布用的构建产物（--no-inbox，正是上传 OSS 的那一份）
public/

# 公众号草稿（scripts/make_article.py 生成，属个人内容，不入库）
out/

# 公众号成品（根目录的「公众号-XXX拆解.html」与发布计划）
# 与 out/ 同理：是给公众号后台粘贴的内容产物，不是这个库的代码或数据。
# 用前缀通配而不是逐个列名 —— 每写一篇就多一个文件，逐个加会一直漏。
公众号-*.html
公众号-*.md

# 部署凭证：绝不入库（AccessKey 只从环境变量或 --env-file 读）
.env
*.env
!.env.example
.ossutilconfig

# WorkBuddy 工作区数据（项目元信息 + 记忆 + 自动化），不入库
.workbuddy/

# 本地调试临时文件（_ 开头，git status --short 一眼能找到的那种）
_*.txt
_*.html
_*.py
# 本地备份与探针目录：含 data/ 快照和 admin.json 备份（后者带签名密钥），
# 也含抓下来的原始响应（大文件、随时可重抓）。都不入库。
_backfill_backup/
_rollback_backup/
_probe/
_shots/

# 公众号发布队列（scripts/wechat_publish.py plan 实时生成，文件头就写着「勿手改」）
# 与 out/ 同理：随时可由 cases.json 重算，提交进来只会天天变。
发布队列-*.md

# 本地探针目录（CDP 截图 + 一次性调试脚本）：产物随时可重生成，不入库
tmp/
