# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 自测产生的备份与临时文件
.selftest_backup/
data/.selftest_backup_cases
data/__test_*.json
data/verification_log.json

# 管理员凭据（后台登录密码摘要 + token 签名密钥）：绝不入库
# 用通配而不是精确名：auth.py --reset / --set 之前人可能会先备份一份，
# 那个 .bak 里带着**同一个签名密钥**，漏掉它等于凭据照样进了库。
data/admin.json
data/admin.json.*
data/verifications.json
# LLM API Key（后台「AI 核实」面板保存的那份）：绝不入库
data/secrets.json
# 掘金登录凭证（cookie 鉴权，等同密码）—— 绝不能进仓库。
# 为什么单列而不靠 data/ 通配：项目里 data/*.json 台账（cases/bili_drafts/
# publish_manifest…）都是**要跟踪**的业务数据，通配一刀切会把它们一起丢掉。
data/juejin_cookie.json
data/juejin_cookie.json.*
# CSDN 登录凭证（cookie 鉴权，等同密码）—— 2026-10-28 接入第六平台时补的规则。
# ⚠ 这条规则**晚于文件出现**：`data/csdn_cookie.json` 先落了盘才想起来加。
# 只要它没被 add 过就还干净，但每次提交前仍要 `git check-ignore -v` 复核。
data/csdn_cookie.json
data/csdn_cookie.json.*
# 博客园 MetaWeblog 访问令牌（同上，等同密码）
data/cnblogs_config.json
data/cnblogs_config.json.*

# 《31个可复制的AI产品》PDF 买家台账：含第三方微信昵称，属个人数据，绝不入库
data/pdf31_buyers.csv

# 本地服务日志
*.log

# IndieHackers sitemap slug 缓存（scripts/harvest.py 生成）
# 属派生数据：默认通道走列表页，不需要它；提交进来只会变成会长期增长的噪音。
data/ih_slugs.json

# TrustMRR sitemap 档案缓存（scripts/harvest.py 的 trustmrr_sitemap 通道生成）
# 同 ih_slugs——纯派生数据：sitemap 快照（1.1 万条 slug）+ 档案池 + 游标，
# 每跑一次采集就重写。而且 CI 每次都是全新 runner、缓存更新随 runner 消亡，
# 跨 run 连续性本来就是零，提交它换不来任何东西。
# ⚠ 它曾被 main 追踪（早一次误提交，全库只有那一个 commit 碰过它），后果：
# harvest 一跑，daily_harvest.py 就把这坨机器数据 commit 到本地 main
# （2026-10-19 实跑日志里的 a3052bf）——既脏了 main，又把「校验」步骤的
# data/ 干净断言洗成假绿。取消追踪后本地已有缓存文件保留在磁盘上继续用。
data/trustmrr_profiles.json

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 初筛结果快照（scripts/triage.py --write 生成）
# 属派生数据：随时可由 scripts/triage.py 重算，且**每天都不一样** ——
# 提交进来只会变成一份很快过期的噪音。
data/triage.json

# 采集队列（data/inbox.json 等）—— 机器数据，每天高频变动
# 注意：这些文件**只在独立的 `data` 分支**里被 GitHub Actions 的 harvest.yml
# 提交/累积，main 分支永不追踪它们。这样 main 只承载人工的代码/案例改动，
# 你本地 push 永远是快进、不再需要 rebase。
# 要本地构建 dist（含 inbox）时，从 data 分支取回：bash scripts/sync_inbox.sh
data/inbox.json
data/inbox_archive.json
data/last_harvest.json

# 静态构建产物（scripts/build_static.py 生成，不入库）
dist/
# 对外发布用的构建产物（--no-inbox，正是上传 OSS 的那一份）
public/

# howtomakemi 增量管线 GUI（gui/）：PyInstaller 中间产物与 spec 不入库。
# exe 落在 gui/dist/，被上面的 `dist/` 通配挡住；要重建随时
# `python -X utf8 gui/build_exe.py`（源码 gui/htm_increment_gui.py 入库）。
gui/build/
gui/*.spec

# 公众号草稿（scripts/make_article.py 生成）
# 默认整目录不入库：out/xhs 里是 176MB 封面图，out/toutiao / out/bili / out/preview
# 是各平台的可再生中间产物，重跑脚本就能再生成一遍。
# ⚠ 用 `out/*` 而不是 `out/`：git 的规则是「父目录被排除时，子文件无法再被单独
# 放行」，整目录一刀切会让下面的例外失效。
out/*
# 例外：out/articles/ 是**唯一无法重建的资产** —— 每条案例一份 .md（原稿）+
# 一份 .html（公众号粘贴用）。重跑脚本能生成「草稿」，但生成不出当时定稿的措辞；
# 已经写过 500 多个文件、发过几十篇，把它们挡在库外等于把这一年的东西押在
# 本地磁盘上（换机 / 误删即永久丢失）。2026-10-26 按要求摘出来入库。
!out/articles/

# 公众号成品（根目录的「公众号-XXX拆解.html」与发布计划）
# 与 out/ 同理：是给公众号后台粘贴的内容产物，不是这个库的代码或数据。
# 用前缀通配而不是逐个列名 —— 每写一篇就多一个文件，逐个加会一直漏。
公众号-*.html
公众号-*.md

# 部署凭证：绝不入库（AccessKey 只从环境变量或 --env-file 读）
.env
*.env
!.env.example
.ossutilconfig

# WorkBuddy 工作区数据（项目元信息 + 记忆 + 自动化），不入库
.workbuddy/

# 本地调试临时文件（_ 开头，git status --short 一眼能找到的那种）
# ⚠️ 必须锚定（/ 开头且只匹配一层）：写 `_*.py` 会递归匹配**任意层级**，
# 于是 `scripts/multiplatform/__init__.py` 这种包必须的文件也被忽略
# （2026-09-29 实测：git add 静默跳过，要 -f 才进库）。临时脚本只出现在
# 仓库根与 scripts/ 根，锚定后既不误伤 __init__.py 也不漏。
_*.txt
_*.html
_*.py
/_*.py
/scripts/_*.py
# ⚠️ 例外：`_t_*.py` 是**真回归测试**（下划线只是沿用早期命名，性质同test_*.py），
# 不是临时脚本。2026-10-05 实测踩中：/scripts/_*.py 把 _t_bili_parse / _t_coverdesc /
# _t_hold 三个测试文件全挡在库外 —— 本地跑 708 项全绿，CI 一道也跑不到，
# 「测试全绿」这句话对仓库而言是假的。git 的忽略规则只认路径、读不出文件用途，
# 所以必须显式放行，否则新写的测试又会静默消失。
!/scripts/_t_*.py
# 一次性排障脚本归档（2026-10-18 从 scripts/ 根目录挪进来）。
# `/scripts/_*.py` 只匹配根目录下一层，归档里的文件不会被覆盖到，必须单独挡。
/scripts/_oneoff/
# 本地备份与探针目录：含 data/ 快照和 admin.json 备份（后者带签名密钥），
# 也含抓下来的原始响应（大文件、随时可重抓）。都不入库。
_backfill_backup/
_rollback_backup/
_probe/
_shots/
# 通用临时备份区（手工清理任务时建，如 llm-clean-<时间戳>/）。
# ⚠ 必须排除：这类目录里的 *.bak 是清理**之前**的文件快照，
# 会连当时正在用的 LLM key / admin 签名密钥一起兜住 ——
# 通配 `secrets.json` 这类精确名根本拦不住（文件名带 .bak 后缀）。
_backups/

# 公众号发布队列（scripts/wechat_publish.py plan 实时生成，文件头就写着「勿手改」）
# 与 out/ 同理：随时可由 cases.json 重算，提交进来只会天天变。
发布队列-*.md

# 本地探针目录（CDP 截图 + 一次性调试脚本）：产物随时可重生成，不入库
tmp/

# 探针缓存：抓下来的真实请求体 / 远端草稿正文（.cache/bili_save_capture.json
# 是 draft/add 的抓包样本，.cache/wechat_drafts.json 是 32 条草稿正文全文）。
# 都可由 `probe_*` / `wechat_reconcile.py --fetch` 随时重抓，且含账号内容。
.cache/

# 头条封面批量同步期间的临时目录（scripts/_cov_driver.py 用，跑完即删）
.tmpcov/

# xhs_drafts.json 的手工备份（防 purge 误删，留一次就够）
data/xhs_drafts.json.bak

# xhs 草稿校验的临时产物（scripts/_xhs_verify.py 输出，仅 total/amount_violations）
data/_xhs_verify.json

# wechat_publish.py sync 每次回写前自动生成的台账快照 + 原子写临时文件。
# ⚠ **别提交**：sync 是日常操作，每次都产出一份 .bak，入库只会堆噪音 diff，
# 而真正的权威版本在 git 里（曾靠 `git show HEAD:data/wechat_published.json`
# 从这里恢复过被测试误写的 41 条台账）。留着当本地安全网，但不入库。
data/wechat_published.json.bak
data/wechat_published.json.tmp

# xhs_sync_ledger.py --apply 每次回填前自动快照（data/xhs_published.json.bak-<时间戳>）。
# 同上：本地安全网，不进库（正文差异看 data/xhs_published.json 本身）。
data/*.bak-*

# 注意 data/publish_manifest.json（多平台发布清单）**要入库**：
# 它是「哪条案例在哪个平台发到哪一步」的唯一事实来源（尤其 B站草稿只存在
# 远端，本地无状态文件）。丢了就得靠人肉翻四个平台的草稿箱重建。

# Windows reserved device names. A stray redirect like `> NUL` in Git Bash
# creates a real 0-byte file named NUL, which git refuses to add
# (error: invalid path 'NUL').
NUL
miniprogram/project.private.config.json

# 根目录临时产物：筛选项中间文件（tmp_htm_* / tmp_howtomakemi_* 等，权威口径
# 在 data/htm_backlog_caliber.json）+ 运行日志目录（*.log 已忽略，txt 同理）。
/tmp_*
logs/
